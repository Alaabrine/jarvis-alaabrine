# --- Primary LLM (local-first via Odysseus / Ollama / vLLM / llama.cpp) ---
JARVIS_LLM_BASE_URL=http://localhost:11434/v1
JARVIS_LLM_API_KEY=local
JARVIS_LLM_MODEL=qwen2.5:latest
JARVIS_LLM_PREFER=local

# --- Cloud fallback (used if the local endpoint is unreachable) ---
JARVIS_FALLBACK_BASE_URL=https://api.openai.com/v1
JARVIS_FALLBACK_API_KEY=
JARVIS_FALLBACK_MODEL=gpt-4o-mini

# --- Embeddings (optional; enables semantic memory recall) ---
JARVIS_EMBEDDING_BASE_URL=
JARVIS_EMBEDDING_API_KEY=
JARVIS_EMBEDDING_MODEL=

# --- Server ---
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787
JARVIS_USER_NAME=Sir
JARVIS_HOTKEY=Ctrl+Alt+J

# --- Permissions ---
# Auto-approve irreversible tool calls (delete/overwrite, shutdown/reboot, email)
JARVIS_AUTO_APPROVE=false
# Optional sudo password for privileged shell commands (stored locally; prefer UI settings)
JARVIS_SUDO_PASSWORD=

# --- REM sleep (inactivity memory consolidation) ---
JARVIS_REM_ENABLED=true
JARVIS_REM_IDLE_MINUTES=15
JARVIS_REM_MIN_INTERVAL_MINUTES=60

# --- Web search (optional SearXNG JSON endpoint; falls back to DuckDuckGo) ---
JARVIS_SEARXNG_URL=

# --- Email (optional; seeds the Default profile — add more in Settings) ---
JARVIS_SMTP_HOST=
JARVIS_SMTP_PORT=587
JARVIS_SMTP_USER=
JARVIS_SMTP_PASSWORD=
JARVIS_EMAIL_FROM=
JARVIS_IMAP_HOST=
JARVIS_IMAP_PORT=993
JARVIS_IMAP_USER=
JARVIS_IMAP_PASSWORD=

# --- Telegram bot (remote chat; outbound long-poll, no port exposure) ---
# Create a bot with @BotFather, then set the token and your allowlist.
# Message the bot /whoami to learn your chat_id / user_id.
JARVIS_TELEGRAM_ENABLED=false
JARVIS_TELEGRAM_BOT_TOKEN=
JARVIS_TELEGRAM_ALLOWED_CHAT_IDS=
JARVIS_TELEGRAM_ALLOWED_USER_IDS=
# Stream tool call / result snippets into Telegram (Approve/Deny still always sent).
JARVIS_TELEGRAM_NOTIFY_TOOLS=true

# --- MCP (Streamable HTTP for Cursor / Claude Desktop / other MCP clients) ---
JARVIS_MCP_ENABLED=true
